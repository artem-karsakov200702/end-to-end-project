{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Неделя 3 — EDA и нормализация данных\n",
    "**Вариант 05**: Open-Meteo, Нью-Йорк\n",
    "**Файл**: 2026-05-16_20-22-10.json\n",
    "**Цель**: raw JSON → normalized CSV"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import json\n",
    "from pathlib import Path\n",
    "from datetime import datetime"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Загрузка raw JSON"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "raw_path = \"data/raw/variant_05/2026-05-16_20-22-10.json\"\n",
    "\n",
    "with open(raw_path, 'r', encoding='utf-8') as f:\n",
    "    raw_data = json.load(f)\n",
    "\n",
    "print(f\"Тип данных: {type(raw_data)}\")\n",
    "print(f\"Ключи верхнего уровня: {list(raw_data.keys())}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Информация о местоположении\n",
    "print(f\"Широта: {raw_data['latitude']}\")\n",
    "print(f\"Долгота: {raw_data['longitude']}\")\n",
    "print(f\"Часовой пояс: {raw_data['timezone']}\")\n",
    "print(f\"Высота: {raw_data['elevation']} м\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Изучаем структуру hourly\n",
    "hourly = raw_data['hourly']\n",
    "print(f\"Ключи hourly: {list(hourly.keys())}\")\n",
    "print(f\"Длина временного ряда: {len(hourly['time'])} часов\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Посмотрим первые 3 часа\n",
    "for i in range(3):\n",
    "    print(f\"\\n--- {i+1} ---\")\n",
    "    print(f\"  time: {hourly['time'][i]}\")\n",
    "    print(f\"  temperature: {hourly['temperature_2m'][i]}°C\")\n",
    "    print(f"", humidity: {hourly['relative_humidity_2m'][i]}%\")\n",
    "    print(f\"  precipitation: {hourly['precipitation'][i]} mm\")\n",
    "    print(f\"  wind: {hourly['wind_speed_10m'][i]} km/h\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Определение \"зерна\" таблицы\n",
    "\n",
    "**Одна строка = один час наблюдения**\n",
    "\n",
    "JSON имеет структуру: `hourly` → массивы `time`, `temperature_2m`, `relative_humidity_2m`, `precipitation`, `wind_speed_10m`.\n",
    "\n",
    "Будем разворачивать в плоскую таблицу."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Построение DataFrame"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Создаём DataFrame из hourly\n",
    "df = pd.DataFrame(hourly)\n",
    "\n",
    "print(f\"Размер: {df.shape}\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Добавляем метаданные\n",
    "df['latitude'] = raw_data['latitude']\n",
    "df['longitude'] = raw_data['longitude']\n",
    "df['elevation'] = raw_data['elevation']\n",
    "df['city_id'] = 'US_NYC'\n",
    "df['city_name'] = 'Нью-Йорк'\n",
    "\n",
    "# Переставляем колонки\n",
    "cols = ['time', 'latitude', 'longitude', 'elevation', 'city_id', 'city_name',\n",
    "        'temperature_2m', 'relative_humidity_2m', 'precipitation', 'wind_speed_10m']\n",
    "df = df[cols]\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Проверяем типы ДО очистки\n",
    "print(\"Типы данных до очистки:\")\n",
    "print(df.dtypes)\n",
    "print(f\"\\nПропуски:\\n{df.isnull().sum()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Очистка данных (3 шага)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Шаг 1: Приведение time к datetime"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "df['time'] = pd.to_datetime(df['time'])\n",
    "print(f\"Новый тип time: {df['time'].dtype}\")\n",
    "print(f\"Диапазон: {df['time'].min()} → {df['time'].max()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Шаг 2: Приведение числовых колонок к float"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "numeric_cols = ['temperature_2m', 'relative_humidity_2m', 'precipitation', 'wind_speed_10m']\n",
    "for col in numeric_cols:\n",
    "    df[col] = pd.to_numeric(df[col], errors='coerce')\n",
    "\n",
    "print(df[numeric_cols].dtypes)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Шаг 3: Проверка DQ правил (допустимые диапазоны)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Проверяем валидность\n",
    "invalid_temp = (df['temperature_2m'] < -80) | (df['temperature_2m'] > 60)\n",
    "invalid_humidity = (df['relative_humidity_2m'] < 0) | (df['relative_humidity_2m'] > 100)\n",
    "invalid_precip = (df['precipitation'] < 0)\n",
    "\n",
    "print(f\"Некорректная температура: {invalid_temp.sum()}\")\n",
    "print(f\"Некорректная влажность: {invalid_humidity.sum()}\")\n",
    "print(f\"Отрицательные осадки: {invalid_precip.sum()}\")\n",
    "\n",
    "# Заменяем невалидные на NaN\n",
    "df.loc[invalid_temp, 'temperature_2m'] = np.nan\n",
    "df.loc[invalid_humidity, 'relative_humidity_2m'] = np.nan\n",
    "df.loc[invalid_precip, 'precipitation'] = np.nan"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Добавление полезных признаков"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "df['date'] = df['time'].dt.date\n",
    "df['hour'] = df['time'].dt.hour\n",
    "df['is_rainy'] = df['precipitation'] > 0\n",
    "\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Итоговая проверка"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "print(f\"Строк: {len(df)}\")\n",
    "print(f\"\\nТипы после очистки:\")\n",
    "print(df.dtypes)\n",
    "print(f\"\\nПропуски:\\n{df.isnull().sum()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Статистика\n",
    "df[numeric_cols].describe()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Сохранение normalized CSV"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "normalized_dir = Path(\"data/normalized/variant_05\")\n",
    "normalized_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "timestamp = datetime.now().strftime(\"%Y-%m-%d_%H-%M-%S\")\n",
    "output_path = normalized_dir / f\"{timestamp}.csv\"\n",
    "\n",
    "df.to_csv(output_path, index=False, encoding='utf-8')\n",
    "print(f\"Сохранено: {output_path}\")\n",
    "print(f\"Размер: {output_path.stat().st_size} байт\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Часть 0 — broken_pandas_read.py"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "from io import StringIO\n",
    "\n",
    "print(\"=== Исправленный CSV (sep=';') ===\")\n",
    "csv_text = \"id;value\\n1;10\\n2;20\\n3;30\\n\"\n",
    "df_test = pd.read_csv(StringIO(csv_text), sep=\";\")\n",
    "print(df_test.head())\n",
    "print(f\"\\nТипы:\\n{df_test.dtypes}\")\n",
    "print(f\"Среднее value: {df_test['value'].mean()}\")\n",
    "\n",
    "print(\"\\n=== Тест 1: пустая строка ===\")\n",
    "csv_text_2 = \"id;value\\n1;10\\n\\n3;30\\n\"\n",
    "df_test2 = pd.read_csv(StringIO(csv_text_2), sep=\";\")\n",
    "print(f\"Строк: {len(df_test2)}\")\n",
    "print(df_test2)\n",
    "\n",
    "print(\"\\n=== Тест 2: пропуск в value ===\")\n",
    "csv_text_3 = \"id;value\\n1;10\\n2;\\n3;30\\n\"\n",
    "df_test3 = pd.read_csv(StringIO(csv_text_3), sep=\";\")\n",
    "print(df_test3)\n",
    "print(f\"Тип value: {df_test3['value'].dtype}\")\n",
    "print(f\"Среднее: {df_test3['value'].mean()}\")"
   ]
  }
 ],
